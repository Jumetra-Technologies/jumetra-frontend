{
  "name": "@kiungo/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Kiungo design tokens, the theme and the interface pieces the website, the lab and the desktop app share.",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./src/tokens.css",
    "./theme.css": "./src/theme.css",
    "./assets/*": "./assets/*",
    "./cn": "./src/cn.ts",
    "./views": "./src/views.ts",
    "./clipboard": "./src/clipboard.ts",
    "./use-turntable": "./src/use-turntable.ts",
    "./*": "./src/*.tsx"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.34.0",
    "tailwind-merge": "^3.6.0"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  }
}

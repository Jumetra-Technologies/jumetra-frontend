{
  "name": "@kiungo/desktop",
  "productName": "Kiungo",
  "version": "0.2.0",
  "private": true,
  "description": "Kiungo 2: the desktop app for building, coding and running robotics projects.",
  "author": "Kiungo Labs Technologies",
  "homepage": "https://jumetra-frontendv0.vercel.app",
  "repository": {
    "type": "git",

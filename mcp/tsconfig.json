{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "baseUrl": ".",
    "paths": { "@/*": ["../*"], "@kiungo/core/parts": ["../packages/core/src/parts/index.ts"], "@kiungo/core/*": ["../packages/core/src/*"] },
    "types": ["node"]
  },
  "include": ["src/**/*.ts"]
}

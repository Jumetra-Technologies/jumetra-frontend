{
  "name": "@kiungo/core",
  "version": "0.1.0",
  "private": true,
  "description": "The Kiungo engine shared by the website and the desktop app: parts, the lab model, firmware files and the board emulator.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./parts": "./src/parts/index.ts",
    "./parts/*": "./src/parts/*.ts",
    "./lab/*": "./src/lab/*.ts",
    "./firmware/*": "./src/firmware/*.ts",
    "./emulator": "./src/emulator/index.ts",
    "./emulator/*": "./src/emulator/*.ts",
    "./sim/*": "./src/sim/*.ts",
    "./boards": "./src/boards/index.ts",
    "./hybrid/*": "./src/hybrid/*.ts"
  },
  "dependencies": {
    "@xyflow/system": "0.0.80",
    "avr8js": "0.21.1"
  }
}

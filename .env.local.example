# Local development. On Vercel set these to the Firebase Cloud Run API.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8000

# Firebase web app config (public; get these from Firebase Console > Project settings > Your apps).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=hhipsystemv0.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=hhipsystemv0
NEXT_PUBLIC_FIREBASE_APP_ID=
